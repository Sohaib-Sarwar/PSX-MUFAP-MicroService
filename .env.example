# ── Service ───────────────────────────────────────────────────────────────────
SERVICE_NAME=psx-mufap-micro-service
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json            # json | text

# ── Snapshot store ────────────────────────────────────────────────────────────
# memory : long-running process (Docker, Railway, local uvicorn)
# redis  : serverless (Vercel), where process memory does not survive
# file   : batch jobs (the GitHub Actions scrapers) — one JSON file per dataset
# Left unset, redis is selected automatically when the Upstash vars are present.
SNAPSHOT_STORE=memory
SNAPSHOT_DIR=data
UPSTASH_REDIS_REST_URL=YOUR_UPSTASH_REST_URL
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REST_TOKEN

# ── Background refresh ────────────────────────────────────────────────────────
# Defaults to true for the memory store, false for redis (Vercel Cron instead).
# SCHEDULER_ENABLED=true
PSX_INTERVAL_OPEN_SECONDS=90       # while the market is ticking
PSX_INTERVAL_CLOSED_SECONDS=1800   # when it is closed
MUFAP_INTERVAL_SECONDS=3600        # NAV publishes once per business day

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED to enable POST /internal/refresh and the per-domain refresh routes.
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
INTERNAL_TOKEN=YOUR_INTERNAL_TOKEN

# Comma-separated origins. Use explicit origins in production, not "*".
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
RATE_LIMIT_PER_MINUTE=120

# ── Resource ceiling ──────────────────────────────────────────────────────────
# Hard address-space cap for the batch scrapers, in MiB. 0 disables it. POSIX
# only — ignored on Windows. Measured peak for a full run is under 200 MiB.
MAX_MEMORY_MB=0

# ── MUFAP client ──────────────────────────────────────────────
# MUFAP sits behind Cloudflare bot management. curl_cffi negotiates a standard
# browser TLS profile, which is what makes the (robots.txt-permitted) request
# work. "httpx" forces the plain client. PSX never uses this path.
MUFAP_HTTP_CLIENT=curl_cffi
MUFAP_IMPERSONATE=chrome
# Profiles to try in order when Cloudflare refuses. Comma separated; overrides
# MUFAP_IMPERSONATE entirely. Worth tuning from a datacenter IP, which is scored
# far more harshly than a residential one.
# MUFAP_IMPERSONATE_CHAIN=chrome131,safari180,firefox135
MUFAP_RETRY_BACKOFF_SECONDS=12

# ── Data validation ───────────────────────────────────────────────────────────
# PSX withdrew its bulk quote feed on 2026-09-24, so today's OHLC and session
# volume survive only on each instrument's own page. This many of the largest
# instruments get one each per run; 0 disables it.
PSX_DETAIL_BUDGET=120
PSX_DETAIL_PAUSE_SECONDS=0.12

PSX_MIN_ROWS=50
MUFAP_MIN_ROWS=100
MAX_ROW_DROP_RATIO=0.5

# ── HTTP ──────────────────────────────────────────────────────────────────────
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=2

# ── Serving ───────────────────────────────────────────────────────────────────
PORT=8000
SERVE_STATIC=true
